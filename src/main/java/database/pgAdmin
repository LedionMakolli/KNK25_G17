 -----   ENUMS    ----

CREATE TYPE ActionEnum AS ENUM ('LOG_IN', 'SIGN_UP');
CREATE TYPE FuelEnum AS ENUM ('GASOLINE', 'DIESEL', 'ELECTRIC', 'HYBRID');
CREATE TYPE CarStatusEnum AS ENUM ('AVAILABLE', 'RESERVED', 'IN_SERVICE');
CREATE TYPE TransmissionTypeEnum AS ENUM ('MANUAL', 'AUTOMATIC');
CREATE TYPE StaffPositionEnum AS ENUM('ADMIN', 'MANAGER', 'STAFF', 'MECHANIC');
CREATE TYPE ReservationStatusEnum AS ENUM ( 'ACTIVE', 'ENDED', 'CANCELLED');
CREATE TYPE StatusMaintenanceEnum AS ENUM ('PLANED', 'IN_PROCESS', 'FINISHED', 'CANCELED');
CREATE TYPE PaymentEnum AS ENUM ('CARD', 'CASH');
CREATE TYPE InsuranceCompanyEnum AS ENUM ('KASKO', 'EUROSIG', 'SIGMA');

 -----   Clients    ----

CREATE TABLE Clients (
     id SERIAL PRIMARY KEY,
     firstname VARCHAR(255),
     lastname VARCHAR(255),
     age integer,
	 personalnumber VARCHAR(20),
	 email VARCHAR(255) UNIQUE,
     username varchar(30) UNIQUE,
 	 password VARCHAR(300),
 	 salt varchar(300),
     telephonenumber VARCHAR(20)
);

 ----- Stafi ----

CREATE TABLE Staff (
     id SERIAL PRIMARY KEY,
     firstName VARCHAR(255),
     lastName VARCHAR(255),
     age integer,
 	 personalnumber VARCHAR(20),
     email VARCHAR(255) UNIQUE,
     username varchar(30) UNIQUE,
     password VARCHAR(300),
     salt varchar(300),
     telephoneNumber VARCHAR(20),
     position StaffPositionEnum DEFAULT 'STAFF',
     employmentDate DATE,
     Salary real
);

 -----   Cars    ----

CREATE TABLE Cars (
    id SERIAL PRIMARY KEY,
    licensePlate VARCHAR(15) NOT NULL UNIQUE,
    model VARCHAR(50) NOT NULL,
    color VARCHAR(20),
    yearOfManufacture INT CHECK (yearOfManufacture >= 1900),
    mileage DECIMAL(10, 2) CHECK (mileage >= 0),
    seatCount INT CHECK (seatCount > 0),
    fuelType FuelEnum NOT NULL,
    dailyPrice DECIMAL(10, 2) CHECK (dailyPrice >= 0),
    status CarStatusEnum DEFAULT 'AVAILABLE',
    transmissionType TransmissionTypeEnum NOT NULL,
    imagePath TEXT
);

 -----   RESERVATIONS    ----

CREATE TABLE Reservations (
    id SERIAL PRIMARY KEY,
    idClient INT REFERENCES Clients(id) ON DELETE CASCADE,
    idCar INT REFERENCES Cars(id) ON DELETE CASCADE,
    startDate DATE NOT NULL,
    endDate DATE NOT NULL,
    reservationStatus ReservationStatusEnum NOT NULL DEFAULT 'ACTIVE',
    createdAt TIMESTAMP DEFAULT NOW(),
    CHECK (startDate < endDate)
);

 -----PromoCode ----

CREATE TABLE PROMOCODE (
    id SERIAL PRIMARY KEY,
    code VARCHAR(255) NOT NULL,
    discount DOUBLE PRECISION NOT NULL,
    expiryDate DATE,
    active BOOLEAN
);

----- Payments -----

  CREATE TABLE payments (
      id SERIAL PRIMARY KEY,
      idreservation INTEGER NOT NULL,
      type VARCHAR(50) NOT NULL,
      promocodeid INTEGER references promocode(id),
      totalnodiscount NUMERIC(10, 2) NOT NULL,
      totalfinal NUMERIC(10, 2) NOT NULL,
      date TIMESTAMP NOT NULL
  );


 -----   Contract    ----

CREATE TABLE Contract (
     id SERIAL PRIMARY KEY,
     idReservation INT REFERENCES Reservations(id) ON DELETE CASCADE,
     sum REAL NOT NULL,
     idPayment INT NOT NULL REFERENCES Payments(id) ON DELETE CASCADE,
     date TIMESTAMP NOT NULL
);

 -----   Sigurimi    ----

CREATE TABLE Insurance (
    id SERIAL PRIMARY KEY,
    idCar INT REFERENCES Cars(id) ON DELETE CASCADE,
    company InsuranceCompanyEnum NOT NULL,
    StartDate DATE NOT NULL,
    EndDate DATE NOT NULL,
    cost DECIMAL(10,2) NOT NULL
);

 -----   Offers    ----

CREATE TABLE offers (
    id SERIAL PRIMARY KEY,
    idCar INT REFERENCES Cars(id) ON DELETE CASCADE,
    discount DECIMAL(10,2) NOT NULL,
    startDate DATE NOT NULL,
    endDate DATE NOT NULL
    CHECK (endDate >= startDate)
);


 -----   Reviews    ----

CREATE TABLE reviews (
    id SERIAL PRIMARY KEY,
    idClient INT REFERENCES Clients(id) ON DELETE CASCADE,
    idCar INT REFERENCES Cars(id) ON DELETE CASCADE,
    rating INT CHECK (rating BETWEEN 1 AND 5) NOT NULL,
    text TEXT,
    date TIMESTAMP NOT NULL
);


 ----- Penalizimet ----

CREATE TABLE Penalties (
    id SERIAL PRIMARY KEY,
    reservationId INT NOT NULL REFERENCES Reservations(id),
    reasonOfPenalty VARCHAR(255) NOT NULL,
    moneyAmount DECIMAL(10, 2) NOT NULL,
    date TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    paid BOOLEAN NOT NULL
);

 ----- Maintenance ---

CREATE TABLE Maintenance (
    id SERIAL PRIMARY KEY,
    idCar INT REFERENCES Cars(id) ON DELETE CASCADE,
    description TEXT,
    dateStart DATE,
    dateFininsh DATE,
    cost DECIMAL(10,2),
    status StatusMaintenanceEnum,
    idStaff INT REFERENCES Staff(id) ON DELETE SET NULL
);

 ----- Documents ---

CREATE TABLE Documents (
        id SERIAL PRIMARY KEY,
        idContract INT REFERENCES Contract(id) ON DELETE CASCADE,
        type VARCHAR(10) NOT NULL,
        path TEXT NOT NULL,
        dataUpload DATE NOT NULL
);

---- SpecialRequests ----

 CREATE TABLE SpecialRequests (
     id SERIAL PRIMARY KEY,
     idReservation INT NOT NULL REFERENCES Reservations(id) ON DELETE CASCADE,
     request TEXT NOT NULL,
     completed BOOLEAN DEFAULT FALSE
 );


----- LogActivity -----

CREATE TABLE LogActivity (
  id SERIAL PRIMARY KEY,
  clientUsername VARCHAR(30) REFERENCES Clients(username),
  staffUsername VARCHAR(30) REFERENCES Staff(username),
  action varchar(40) NOT NULL,
  date TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,

  CONSTRAINT chk_one_username_only
    CHECK (
      (clientUsername IS NOT NULL AND staffUsername IS NULL)
      OR
      (staffUsername IS NOT NULL AND clientUsername IS NULL)
    )
);



