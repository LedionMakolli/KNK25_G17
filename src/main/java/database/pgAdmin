// -----   Cars    ----

CREATE TABLE Cars (
    id SERIAL PRIMARY KEY,
    licensePlate VARCHAR(15) NOT NULL UNIQUE,
    model VARCHAR(50) NOT NULL,
    color VARCHAR(20),
    yearOfManufacture INT CHECK (yearOfManufacture >= 1900),
    mileage DECIMAL(10, 2) CHECK (mileage >= 0),
    seatCount INT CHECK (seatCount > 0),
    fuelType FuelDto NOT NULL,
    dailyPrice DECIMAL(10, 2) CHECK (dailyPrice >= 0),
    status CarStatusEnum DEFAULT 'AVAILABLE',
    transmissionType TransmissionType NOT NULL
);

// -----   REZERVIMET    ----
CREATE TABLE Rezervimet (
    id SERIAL PRIMARY KEY,
    idKlienti INT REFERENCES Klientet(id) ON DELETE CASCADE,
    idVetura INT REFERENCES Veturat(id) ON DELETE CASCADE,
    dataFillimit DATE NOT NULL,
    dataMbarimit DATE NOT NULL,
    statusiRezervimet Statusi_Rezervimet NOT NULL DEFAULT 'REZERVIMI_AKTIV',
    createdAt TIMESTAMP DEFAULT NOW(),
    CHECK (dataFillimit < dataMbarimit)
);

