
#################### Tabelat per bazen e te dhenave ###########################


CREATE TABLE KLIENTET (
    ID_Klienti serial primary key,
    Emri varchar(255) not null,
    Mbiemri VARCHAR(255) not null,
    Nr_Personal varchar(20) unique not null,
    Telefoni varchar(20) unique not null
);

CREATE TABLE Veturat (
    ID_Vetura SERIAL PRIMARY KEY,
    Targat VARCHAR(15) NOT NULL UNIQUE,
    Modeli VARCHAR(50) NOT NULL,
    Ngjyra VARCHAR(20),
    Viti_Prodhimit DECIMAL(5) CHECK (Viti_Prodhimit >= 1900),
    Kilometrazha DECIMAL(10,2) CHECK (Kilometrazha >= 0),
    Numri_Uleseve INT CHECK (Numri_Uleseve > 0),
    Karburanti Karburanti NOT NULL,
    Cmimi_ditor DECIMAL(10,2) CHECK (Cmimi_ditor >= 0),
    Statusi Statusi DEFAULT 'NE_DISPOZICION'
);

CREATE TABLE Rezervimet (
    id_rezervimet SERIAL PRIMARY KEY,
    id_klienti INT REFERENCES Klientet(ID_Klienti) ON DELETE CASCADE,
    id_vetura INT REFERENCES Veturat(ID_Vetura) ON DELETE CASCADE,
    data_fillimit DATE NOT NULL,
    data_mbarimit DATE NOT NULL,
    statusi_rezervimet Statusi_Rezervimet NOT NULL DEFAULT 'REZERVIMI_AKTIV',
    created_At TIMESTAMP DEFAULT NOW(),
    CHECK (data_fillimit < data_mbarimit)
);

CREATE TABLE Kontrata (
    ID_Kontrata SERIAL PRIMARY KEY,
    ID_Rezervimi INT REFERENCES Rezervimet(ID_Rezervimi) ON DELETE CASCADE,
    Shuma_Totale REAL NOT NULL,
    Metoda ENUM('Kartë Krediti', 'Cash') NOT NULL,
    Data_Leshimit TIMESTAMP NOT NULL
);

CREATE TABLE Sigurimi (
    ID_Sigurimi SERIAL PRIMARY KEY,
    ID_Vetura INT REFERENCES Veturat(ID_Vetura) ON DELETE CASCADE,
    Kompania VARCHAR(255) NOT NULL,
    Data_Fillimit DATE NOT NULL,
    Data_Mbarimit DATE NOT NULL,
    Kosto DECIMAL(10,2) NOT NULL
);

CREATE TABLE Ofertat (
    ID_Oferta SERIAL PRIMARY KEY,
    ID_Vetura INT REFERENCES Veturat(ID_Vetura) ON DELETE CASCADE,
    Zbritja DECIMAL(10,2) NOT NULL,
    Data_Fillimit DATE NOT NULL,
    Data_Mbarimit DATE NOT NULL
);

CREATE TABLE Vleresimet (
    ID_Vleresimi SERIAL PRIMARY KEY,
    ID_Klienti INT REFERENCES Klientet(ID_Klienti) ON DELETE CASCADE,
    ID_Vetura INT REFERENCES Veturat(ID_Vetura) ON DELETE CASCADE,
    Rating INT CHECK (Rating BETWEEN 1 AND 5) NOT NULL,
    Koment TEXT,
    Data TIMESTAMP NOT NULL
);
