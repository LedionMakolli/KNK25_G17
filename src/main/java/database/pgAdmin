-----   Veturat    ----

CREATE TABLE Veturat (
    id SERIAL PRIMARY KEY,
    targat VARCHAR(15) NOT NULL UNIQUE,
    modeli VARCHAR(50) NOT NULL,
    ngjyra VARCHAR(20),
    vitiProdhimit DECIMAL(5) CHECK (vitiProdhimit >= 1900),
    kilometrazha DECIMAL(10,2) CHECK (kilometrazha >= 0),
    numriUleseve INT CHECK (numriUleseve > 0),
    karburanti Karburanti NOT NULL,
    cmimiDitor DECIMAL(10,2) CHECK (cmimiDitor >= 0),
    statusi StatusiVeturaEnum DEFAULT 'NE_DISPOZICION'
);

-----   REZERVIMET    ----
CREATE TABLE Rezervimet (
    id SERIAL PRIMARY KEY,
    idKlienti INT REFERENCES Klientet(id) ON DELETE CASCADE,
    idVetura INT REFERENCES Veturat(id) ON DELETE CASCADE,
    dataFillimit DATE NOT NULL,
    dataMbarimit DATE NOT NULL,
    statusiRezervimet Statusi_Rezervimet NOT NULL DEFAULT 'REZERVIMI_AKTIV',
    createdAt TIMESTAMP DEFAULT NOW(),
    CHECK (dataFillimit < dataMbarimit)
);

-----   Kontrata    ----

CREATE TYPE Pagesa AS ENUM ('KESH', 'KARTELE');

CREATE TABLE Kontrata (
    id SERIAL PRIMARY KEY,
    idRezervimet INT NOT NULL,
    shuma REAL NOT NULL,
    pagesa Pagesa NOT NULL,
    data TIMESTAMP NOT NULL
);

-----   Sigurimi    ----

CREATE TABLE Sigurimi (
    id SERIAL PRIMARY KEY,
    idVetura INT REFERENCES Veturat(id) ON DELETE CASCADE,
    kompania VARCHAR(255) NOT NULL,
    dataFillimit DATE NOT NULL,
    dataMbarimit DATE NOT NULL,
    kosto DECIMAL(10,2) NOT NULL
);

-----   Ofertat    ----

CREATE TABLE Ofertat (
    id SERIAL PRIMARY KEY,
    idVetura INT REFERENCES Veturat(id) ON DELETE CASCADE,
    zbritja DECIMAL(10,2) NOT NULL,
    dataFillimit DATE NOT NULL,
    dataMbarimit DATE NOT NULL
    CHECK (dataMbarimit >= dataFillimit)
);

-----   Vleresimet    ----

CREATE TABLE Vleresimet (
    id SERIAL PRIMARY KEY,
    idKlienti INT REFERENCES Klientet(id) ON DELETE CASCADE,
    idVetura INT REFERENCES Veturat(id) ON DELETE CASCADE,
    rating INT CHECK (rating BETWEEN 1 AND 5) NOT NULL,
    text TEXT,
    data TIMESTAMP NOT NULL
);


----- Penalizimet ----

CREATE TABLE PENALIZIMET (
    id SERIAL PRIMARY KEY,
    idRezervimet INT NOT NULL REFERENCES REZERVIMET(id),
    arsyeja VARCHAR(255) NOT NULL,
    shuma DECIMAL(10, 2) NOT NULL,
    data TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    paguar BOOLEAN NOT NULL
);

-----PromoCode ----
CREATE TABLE PROMOCODE (
    id SERIAL PRIMARY KEY,
    kodi VARCHAR(255) NOT NULL,
    zbritja DOUBLE PRECISION NOT NULL,
    dataSkadimit DATE,
    aktiv BOOLEAN
);

--- Mirembajtja---
CREATE TABLE Mirembajtja (
    id SERIAL PRIMARY KEY,
    idVetura INT REFERENCES Veturat(id) ON DELETE CASCADE,
    pershkrimi TEXT,
    dataFillimit DATE,
    dataMbarimit DATE,
    kosto DECIMAL(10,2),
    statusi StatusiMirembatjaEnum,
    idStafi INT REFERENCES stafi(id) ON DELETE SET NULL
);

