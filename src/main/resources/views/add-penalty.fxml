<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.RadioMenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="400.0" prefWidth="640.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AddPenaltyController">
    <children>
        <MenuBar VBox.vgrow="NEVER">
            <menus>
                <Menu mnemonicParsing="false" text="%txt.Homepage">
                    <items>
                        <MenuItem fx:id="gotoHomepage" mnemonicParsing="false" onAction="#goToHomepage" text="Go to Home" />
                    </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Settings">
                    <items>
                        <MenuItem fx:id="changePassword" mnemonicParsing="false" onAction="#handleChangePassword" text="%txt.changePassword" />
                        <MenuItem fx:id="seeDocuments" mnemonicParsing="false" onAction="#seeDocuments" text="%txt.seeDocuments" />
                        <MenuItem fx:id="seeContract" mnemonicParsing="false" onAction="#seeContracts" text="%txt.seeContract" />
                        <MenuItem fx:id="seePenalties" mnemonicParsing="false" onAction="#seePenalties" text="%txt.seePenalties" />
                        <MenuItem fx:id="signOut" mnemonicParsing="false" onAction="#SignOut" text="%txt.SignOut" />
                    </items>
                </Menu>
                <Menu mnemonicParsing="false" text="%txt.Edit">
                    <items>
                        <RadioMenuItem fx:id="txtShqip" mnemonicParsing="false" onAction="#setAlbanianLanguage" text="Shqip" />
                        <RadioMenuItem fx:id="txtEnglish" mnemonicParsing="false" onAction="#setEnglishLanguage" text="English" />
                    </items>
                </Menu>
                <Menu mnemonicParsing="false" text="%txt.Help">
                    <items>
                        <MenuItem mnemonicParsing="false" text="About" />
                    </items>
                </Menu>

                <Menu fx:id="menuAdd" mnemonicParsing="false" text="%txt.Add">
                    <items>
                        <MenuItem fx:id="addContract" mnemonicParsing="false" onAction="#handleAddContract" text="%txt.AddContract" />
                        <MenuItem fx:id="addPayment" mnemonicParsing="false" text="%txt.AddPayment" onAction="#handleAddPayment"/>
                        <MenuItem fx:id="addPenalty" mnemonicParsing="false" text="%txt.addPenalty" onAction="#handleAddPenalty"/>
                    </items>
                </Menu>
            </menus>
        </MenuBar>
        <AnchorPane maxHeight="-1.0" maxWidth="-1.0" prefHeight="-1.0" prefWidth="-1.0" VBox.vgrow="ALWAYS">
            <children>
                <Label layoutX="247.0" layoutY="32.0" prefHeight="25.0" prefWidth="103.0" text="       Add Penalty">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <VBox layoutX="175.0" layoutY="64.0" spacing="10.0">
                    <children>
                        <HBox spacing="20.0">
                            <children>
                                <Label fx:id="txtReservationId" prefHeight="25.0" prefWidth="97.0" text="Reservation Id:" />
                                <TextField fx:id="txtFieldReservationId" />
                            </children>
                        </HBox>
                        <HBox spacing="20.0">
                            <children>
                                <Label fx:id="txtReason" prefHeight="25.0" prefWidth="98.0" text="Reason:" />
                                <TextField fx:id="txtFieldReason" prefWidth="150.0" />
                            </children>
                        </HBox>
                        <HBox spacing="20.0">
                            <children>
                                <Label fx:id="txtAmount" prefHeight="25.0" prefWidth="98.0" text="Amount:" />
                                <TextField fx:id="txtFieldAmount" />
                            </children>
                        </HBox>
                        <HBox spacing="20.0">
                            <children>
                                <Label fx:id="txtDate" prefHeight="25.0" prefWidth="98.0" text="Date:" />
                                <DatePicker fx:id="dpDate" prefWidth="150.0" />
                            </children>
                        </HBox>
                        <HBox spacing="20.0">
                            <children>
                                <Label fx:id="txtPaid" prefHeight="25.0" prefWidth="100.0" text="Paid:" />
                                <CheckBox fx:id="cbPaid" mnemonicParsing="false" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
                <HBox layoutX="198.0" layoutY="295.0" spacing="40.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleCancelClick" prefHeight="33.0" prefWidth="97.0" text="Cancel" />
                        <Button mnemonicParsing="false" onAction="#handleSaveClick" prefHeight="33.0" prefWidth="97.0" text="Save" />
                    </children>
                </HBox>
            </children>
        </AnchorPane>
    </children>
</VBox>