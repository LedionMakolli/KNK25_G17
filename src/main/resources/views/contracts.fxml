<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.ContractsController">

    <TableView fx:id="contractsTable" layoutX="10" layoutY="10" prefHeight="400" prefWidth="600">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
            <TableColumn fx:id="paymenIdColumn" text="Payment ID" prefWidth="100"/>
            <TableColumn fx:id="reservationIdColumn" text="Reservation ID" prefWidth="150"/>
            <TableColumn fx:id="amountColumn" text="Amount (€)" prefWidth="100"/>
            <TableColumn fx:id="dateColumn" text="Date" prefWidth="150"/>
        </columns>
    </TableView>

    <Button layoutX="520" layoutY="420" text="Refresh" onAction="#initialize"/>
</AnchorPane>