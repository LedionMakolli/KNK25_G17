<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.text.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" prefWidth="600" prefHeight="500" fx:controller="controllers.AboutController">
    <children>
        <VBox spacing="5" AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0">
            <MenuBar>
                <menus>
                    <Menu mnemonicParsing="false" text="%txt.Homepage">
                        <items>
                            <MenuItem fx:id="gotoHomepage" mnemonicParsing="false" onAction="#goToHomepage" text="Go to Home" />
                        </items>
                    </Menu>
                    <Menu mnemonicParsing="false" text="Settings">
                        <items>
                            <MenuItem fx:id="changePassword" mnemonicParsing="false" text="%txt.changePassword" onAction="#handleChangePassword"/>
                            <MenuItem fx:id="seeDocuments" mnemonicParsing="false" text="%txt.seeDocuments" onAction="#seeDocuments"/>
                            <MenuItem fx:id="seeContract" mnemonicParsing="false" text="%txt.seeContract" onAction="#seeContracts"/>
                            <MenuItem fx:id="seePenalties" mnemonicParsing="false" onAction="#seePenalties" text="%txt.seePenalties" />
                            <MenuItem fx:id="SignOut" mnemonicParsing="false" text="%txt.SignOut" onAction="#SignOut"/>
                        </items>
                    </Menu>
                    <Menu mnemonicParsing="false" text="%txt.Edit">
                        <items>
                            <RadioMenuItem fx:id="txtShqip" mnemonicParsing="false" onAction="#setAlbanianLanguage" text="Shqip" />
                            <RadioMenuItem fx:id="txtEnglish" mnemonicParsing="false" onAction="#setEnglishLanguage" text="English" />
                        </items>
                    </Menu>
                    <Menu mnemonicParsing="false" text="%txt.update">
                        <items>
                            <MenuItem fx:id="updateTable" mnemonicParsing="false" text="%txt.update" onAction="#handleUpdateTable"/>
                        </items>
                    </Menu>
                    <Menu mnemonicParsing="false" text="%txt.Help">
                        <items>
                            <MenuItem fx:id="aboutProgram" mnemonicParsing="false" text="About" onAction="#seeAboutProgram"/>
                        </items>
                    </Menu>
                    <Menu fx:id="menuAdd" mnemonicParsing="false" text="%txt.Add">
                        <items>
                            <MenuItem fx:id="addContract" mnemonicParsing="false" text="%txt.AddContract" onAction="#handleAddContract"/>
                            <MenuItem fx:id="addPayment" mnemonicParsing="false" text="%txt.AddPayment" onAction="#handleAddPayment"/>
                        </items>
                    </Menu>
                </menus>
            </MenuBar>

            <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS">
                <content>
                    <VBox spacing="15" alignment="TOP_LEFT">
                        <padding>
                            <Insets top="20" right="30" bottom="20" left="30"/>
                        </padding>

                        <Label text="About Our Rent a Car System" style="-fx-font-size: 22px; -fx-font-weight: bold;" />

                        <Text wrappingWidth="540" text="Welcome to our Rent a Car platform. Our system is designed to help you easily reserve vehicles based on your preferences and needs." />

                        <Label text="Reservation Options:" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
                        <Text wrappingWidth="540" text="You can browse our available vehicles and make reservations directly through the app. Simply select the car you want, choose the reservation period, and confirm your booking." />

                        <Label text="Contracts and Personal Use:" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
                        <Text wrappingWidth="540" text="Each reservation generates a contract for your personal use. This contract includes the car details, rental period, payment information, and terms of use." />

                        <Label text="Penalties and Rules:" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
                        <Text wrappingWidth="540" text="Please respect the rental rules. Penalties may be applied in case of rule violations or car damages. All penalties will be visible in your reservation history." />

                        <Label text="Password Management:" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
                        <Text wrappingWidth="540" text="For your account security, you can change your password at any time from your profile settings." />

                        <Label text="Language Options:" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
                        <Text wrappingWidth="540" text="You can switch between different languages to use the application in the language you prefer." />

                        <Separator />

                        <Text wrappingWidth="540" text="Thank you for using our service. We wish you a safe and pleasant journey!" />
                    </VBox>
                </content>
            </ScrollPane>
        </VBox>
    </children>
</AnchorPane>
