<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="400.0" prefWidth="640.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AddOffersController">
    <children>
        <MenuBar VBox.vgrow="NEVER">
            <menus>
                <Menu mnemonicParsing="false" text="%txt.Homepage">
                    <items>
                        <MenuItem fx:id="gotoHomepage" mnemonicParsing="false" onAction="#goToHomepage" text="Go to Home" />
                    </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Settings">
                    <items>
                        <MenuItem fx:id="changePassword" mnemonicParsing="false" onAction="#handleChangePassword" text="%txt.changePassword" />
                        <MenuItem fx:id="seeDocuments" mnemonicParsing="false" onAction="#seeDocuments" text="%txt.seeDocuments" />
                        <MenuItem fx:id="seeContract" mnemonicParsing="false" onAction="#seeContracts" text="%txt.seeContract" />
                        <MenuItem fx:id="seePenalties" mnemonicParsing="false" onAction="#seePenalties" text="%txt.seePenalties" />
                        <MenuItem fx:id="seePayments" mnemonicParsing="false" onAction="#seePayments" text="%txt.seePayments" />
                        <MenuItem fx:id="seeReservations" mnemonicParsing="false" onAction="#seeReservations" text="%txt.seeReservations" />
                        <MenuItem fx:id="seeMaintenance" mnemonicParsing="false" onAction="#seeMaintenance" text="%txt.seeMaintenance" />
                        <MenuItem fx:id="seeInsurance" mnemonicParsing="false" onAction="#seeInsurance" text="%txt.seeInsurance" />
                        <MenuItem fx:id="Offers" mnemonicParsing="false" onAction="#Offers" text="%txt.Offers" />
                        <MenuItem fx:id="SignOut" mnemonicParsing="false" onAction="#SignOut" text="%txt.SignOut" />
                    </items>
                </Menu>
                <Menu mnemonicParsing="false" text="%txt.Edit">
                    <items>
                        <RadioMenuItem fx:id="txtShqip" mnemonicParsing="false" onAction="#setAlbanianLanguage" text="Shqip" />
                        <RadioMenuItem fx:id="txtEnglish" mnemonicParsing="false" onAction="#setEnglishLanguage" text="English" />
                    </items>
                </Menu>
                <Menu fx:id="update" mnemonicParsing="false" text="%txt.update">
                    <items>
                        <MenuItem fx:id="updateTable" mnemonicParsing="false" onAction="#handleUpdateTable" text="%txt.updateTables" />
                        <MenuItem fx:id="updateMaintenance" mnemonicParsing="false" onAction="#handleUpdateMaintenance" text="%txt.updateMaintenance" />
                    </items>
                </Menu>
                <Menu mnemonicParsing="false" text="%txt.Help">
                    <items>
                        <MenuItem fx:id="aboutProgram" mnemonicParsing="false" onAction="#seeAboutProgram" text="About" />
                    </items>
                </Menu>

                <Menu fx:id="menuAdd" mnemonicParsing="false" text="%txt.Add">
                    <items>
                        <MenuItem fx:id="addContract" mnemonicParsing="false" onAction="#handleAddContract" text="%txt.AddContract" />
                        <MenuItem fx:id="addPayment" mnemonicParsing="false" onAction="#handleAddPayment" text="%txt.AddPayment" />
                        <MenuItem fx:id="addPenalty" mnemonicParsing="false" onAction="#handleAddPenalty" text="%txt.addPenalty" />
                        <MenuItem fx:id="addMaintenance" mnemonicParsing="false" onAction="#handleAddMaintenance" text="%txt.AddMaintenance" />
                        <MenuItem fx:id="addOffer" mnemonicParsing="false" onAction="#handleAddOffer" text="%txt.addOffer" />
                        <MenuItem fx:id="addReview" mnemonicParsing="false" text="%txt.addReview" onAction="#addReview"/>
                    </items>
                </Menu>
            </menus>
        </MenuBar>

        <AnchorPane maxHeight="-1.0" maxWidth="-1.0" prefHeight="-1.0" prefWidth="-1.0" VBox.vgrow="ALWAYS">
            <children>
                <Label layoutX="255.0" layoutY="14.0" prefHeight="27.0" prefWidth="129.0" text="%txt.addOffer">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
                <VBox layoutX="175.0" layoutY="64.0" spacing="10.0">
                    <children>
                        <HBox spacing="20.0">
                            <children>
                                <Label fx:id="txtCarId" prefHeight="25.0" prefWidth="98.0" text="%txt.carId" />
                                <TextField fx:id="carId" prefWidth="150.0" />
                            </children>
                        </HBox>
                        <HBox spacing="20.0">
                            <children>
                                <Label fx:id="txtDiscount" prefHeight="25.0" prefWidth="98.0" text="%txt.discount" />
                                <TextField fx:id="discount" />
                            </children>
                        </HBox>
                        <HBox spacing="20.0">
                            <children>
                                <Label fx:id="startDate" prefHeight="25.0" prefWidth="98.0" text="%txt.startDate" />
                                <DatePicker fx:id="dpStartDate" prefWidth="150.0" />
                            </children>
                        </HBox>
                        <HBox spacing="20.0">
                            <children>
                                <Label fx:id="endDate" prefHeight="25.0" prefWidth="100.0" text="%txt.endDate" />
                                <DatePicker fx:id="dpEndDate" prefWidth="150.0" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
                <HBox layoutX="198.0" layoutY="295.0" spacing="40.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleCancelClick" prefHeight="33.0" prefWidth="97.0" text="%btn.cancel" />
                        <Button mnemonicParsing="false" onAction="#handleSaveClick" prefHeight="33.0" prefWidth="97.0" style="-fx-background-color: blue;" text="%btn.save" textFill="WHITE" />
                    </children>
                </HBox>
            </children>
        </AnchorPane>
    </children>
</VBox>
